# scripts/init-env.sh で自動生成できます
TZ=Asia/Tokyo

# プロキシ addon <-> API の内部通信トークン(ランダム文字列。フロントエンド用のトークンとは別物)
SHSW_INTERNAL_TOKEN=

# 管理 API の公開アドレス/ポート
API_BIND=0.0.0.0
API_PORT=8000
# 外部から見たバックエンドの URL(UI にトリガー URL・CA 配布 URL として表示される)
# 例: http://192.168.1.10:8000
SHSW_PUBLIC_URL=

# MITM プロキシの公開アドレス/ポート
PROXY_BIND=0.0.0.0
PROXY_PORT=8080

# (任意) プロキシ認証 user:pass
PROXY_AUTH=
# プロキシのログレベル (error/warn/info/debug)
PROXY_LOG_LEVEL=info

# ---- ゲートウェイ構成 (透過プロキシ) ----------------------------------------
# Pi を上位ルーターと Wi-Fi AP の間に置き、配下の端末を設定なしで shsw に通す場合に有効化する。
# 有効化: 次の行のコメントを外す
# COMPOSE_FILE=docker-compose.yml:docker-compose.gateway.yml
# shsw の配下にするインターフェース (カンマ区切り)
#   eth1 = USB LAN の先の Wi-Fi AP / ap0 = Pi 自身の Wi-Fi AP (hostapd)
GATEWAY_LAN_IFACES=ap0
# 上位ルーター側 (空なら既定経路のインターフェースを自動検出)
GATEWAY_WAN_IFACE=
GATEWAY_TRANSPARENT_PORT=8443
# QUIC (UDP 443) を拒否して TCP に落とさせる
GATEWAY_BLOCK_QUIC=true
