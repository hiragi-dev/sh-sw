# scripts/init-env.sh で自動生成できます
TZ=Asia/Tokyo

# プロキシ addon <-> API の内部通信トークン(ランダム文字列。フロントエンド用のトークンとは別物)
SHSW_INTERNAL_TOKEN=

# 管理 API の公開アドレス/ポート
API_BIND=0.0.0.0
API_PORT=8000
# 外部から見たバックエンドの URL(UI にトリガー URL・CA 配布 URL として表示される)
# 例: http://192.168.1.10:8000
SHSW_PUBLIC_URL=

# MITM プロキシの公開アドレス/ポート
PROXY_BIND=0.0.0.0
PROXY_PORT=8080

# mitmdump への追加引数。例: プロキシ認証
# PROXY_EXTRA_ARGS=--set proxyauth=user:pass
PROXY_EXTRA_ARGS=
